<Window x:Class="TaxiApp.NewOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🚖 Новый заказ" Height="650" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F5DC"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#FFD4AF37" CornerRadius="10" Padding="15" Margin="0,0,0,20">
            <TextBlock Text="📝 Создание нового заказа" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Форма -->
        <Border Grid.Row="1" Background="#FFFDF5E0" CornerRadius="10" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Информация о клиенте -->
                    <GroupBox Grid.Row="0" Header="👤 Информация о клиенте" 
                              FontSize="14" FontWeight="Bold" Margin="0,0,0,15">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Клиент:" VerticalAlignment="Center" Margin="0,5"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cmbClient" 
                                      Style="{StaticResource SkeuoComboBox}" Margin="0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Или новый клиент:" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtNewClientName" 
                                     Style="{StaticResource SkeuoTextBox}" Margin="0,5"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Телефон:" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtPhone" 
                                     Style="{StaticResource SkeuoTextBox}" Margin="0,5"/>
                        </Grid>
                    </GroupBox>

                    <!-- Маршрут -->
                    <GroupBox Grid.Row="1" Header="📍 Маршрут поездки" 
                              FontSize="14" FontWeight="Bold" Margin="0,0,0,15">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="🚩 Откуда:" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtPickup" 
                                     Style="{StaticResource SkeuoTextBox}" Margin="0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="🏁 Куда:" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtDropoff" 
                                     Style="{StaticResource SkeuoTextBox}" Margin="0,5"/>
                        </Grid>
                    </GroupBox>

                    <!-- Параметры заказа -->
                    <GroupBox Grid.Row="2" Header="💰 Параметры заказа" 
                              FontSize="14" FontWeight="Bold" Margin="0,0,0,15">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Стоимость (₽):" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtPrice" 
                                     Style="{StaticResource SkeuoTextBox}" Margin="0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Статус:" VerticalAlignment="Center" Margin="0,5"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbStatus" 
                                      Style="{StaticResource SkeuoComboBox}" Margin="0,5">
                                <ComboBoxItem Content="В ожидании" IsSelected="True"/>
                                <ComboBoxItem Content="В пути"/>
                            </ComboBox>
                        </Grid>
                    </GroupBox>

                    <!-- Водитель -->
                    <GroupBox Grid.Row="3" Header="👨‍🚗 Назначить водителя" 
                              FontSize="14" FontWeight="Bold">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Водитель:" VerticalAlignment="Center" Margin="0,5"/>
                            <ComboBox Grid.Column="1" x:Name="cmbDriver" 
                                      Style="{StaticResource SkeuoComboBox}" Margin="0,5">
                                <ComboBoxItem Content="Не назначен" IsSelected="True"/>
                            </ComboBox>
                        </Grid>
                    </GroupBox>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="✅ Создать заказ" Style="{StaticResource SkeuoButton}" 
                    Click="btnCreate_Click" Width="150" Margin="0,0,10,0"/>
            <Button Content="❌ Отмена" Style="{StaticResource SkeuoButton}" 
                    Click="btnCancel_Click" Width="120"/>
        </StackPanel>
    </Grid>
</Window>
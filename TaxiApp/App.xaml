<Application x:Class="TaxiApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style x:Key="SkeuoButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C2C2C"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Shadow" Background="#50000000" CornerRadius="6" 
                                    Margin="0,2,0,0"/>
                            <Border x:Name="MainBorder" CornerRadius="6" BorderBrush="#8B7355" BorderThickness="1,1,1,2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFEBD56E" Offset="0"/>
                                        <GradientStop Color="#FFD4AF37" Offset="0.5"/>
                                        <GradientStop Color="#FFB8941F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Border CornerRadius="5,5,0,0" Margin="2,2,2,0" Height="15" VerticalAlignment="Top">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#90FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center" 
                                                      Margin="{TemplateBinding Padding}"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFF5E080" Offset="0"/>
                                            <GradientStop Color="#FFE4C847" Offset="0.5"/>
                                            <GradientStop Color="#FFC4A62F" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderThickness" Value="1,1,1,1"/>
                                <Setter TargetName="Shadow" Property="Margin" Value="0,0,0,0"/>
                                <Setter TargetName="MainBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFC4A62F" Offset="0"/>
                                            <GradientStop Color="#FFB8941F" Offset="0.5"/>
                                            <GradientStop Color="#FF9A7D1A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SkeuoTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFDF5E0"/>
            <Setter Property="BorderBrush" Value="#8B7355"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="SkeuoComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFDF5E0"/>
            <Setter Property="BorderBrush" Value="#8B7355"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Application.Resources>
</Application>
<Window x:Class="TaxiApp.OrderHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📋 История заказов" Height="650" Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F5DC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#FFD4AF37" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <TextBlock Text="📋 История выполненных и отменённых заказов" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Фильтры -->
        <Border Grid.Row="1" Background="#FFFDF5E0" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="📅 Период:" VerticalAlignment="Center" FontSize="14" Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <DatePicker x:Name="dpFrom" Width="150" Margin="0,0,10,0"/>
                    <TextBlock Text="—" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker x:Name="dpTo" Width="150"/>
                </StackPanel>

                <Button Grid.Column="2" Content="🔍 Применить фильтр" Style="{StaticResource SkeuoButton}" 
                        Click="btnFilter_Click" Width="150"/>
            </Grid>
        </Border>

        <!-- Таблица -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="10" Padding="10">
            <DataGrid x:Name="dgHistory" AutoGenerateColumns="False" 
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      RowHeight="45"
                      FontSize="13">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FFD4AF37"/>
                        <Setter Property="Foreground" Value="#2C2C2C"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,8"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,5"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FFFFE080"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Завершён">
                                <Setter Property="Background" Value="#FFE8F5E0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Отменён">
                                <Setter Property="Background" Value="#FFF5E0E0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="120"/>
                    <DataGridTextColumn Header="Клиент" Binding="{Binding Client.Name}" Width="150"/>
                    <DataGridTextColumn Header="Откуда" Binding="{Binding PickupAddress}" Width="200"/>
                    <DataGridTextColumn Header="Куда" Binding="{Binding DropoffAddress}" Width="200"/>
                    <DataGridTextColumn Header="Водитель" Binding="{Binding Driver.FullName}" Width="150"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2} ₽}" Width="100"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="📊 Статистика" Style="{StaticResource SkeuoButton}" 
                    Click="btnStats_Click" Width="130" Margin="0,0,10,0"/>
            <Button Content="❌ Закрыть" Style="{StaticResource SkeuoButton}" 
                    Click="btnClose_Click" Width="120"/>
        </StackPanel>
    </Grid>
</Window>
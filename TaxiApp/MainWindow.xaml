<Window x:Class="TaxiApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Такси - Управление заказами" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5DC">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#FFD4AF37" CornerRadius="10" Padding="15" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect Color="#80000000" BlurRadius="8" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,15,0">
                    <TextBlock Text="" FontSize="36"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="СИСТЕМА УПРАВЛЕНИЯ ЗАКАЗАМИ ТАКСИ" 
                               FontSize="24" FontWeight="Bold" Foreground="#2C2C2C"/>
                    <TextBlock Text="Быстро. Удобно. Надёжно." 
                               FontSize="14" Foreground="#4A4A4A" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Панель управления -->
        <Border Grid.Row="1" Background="#FFFDF5E0" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect Color="#40000000" BlurRadius="4" ShadowDepth="1"/>
            </Border.Effect>

            <WrapPanel VerticalAlignment="Center">
                <!-- Поиск -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock Text="🔍 Поиск:" VerticalAlignment="Center" FontSize="13" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtSearch" Width="250" Style="{StaticResource SkeuoTextBox}"
                             TextChanged="txtSearch_TextChanged"/>
                </StackPanel>

                <!-- Кнопки действий -->
                <Button Content="➕ Новый заказ" Style="{StaticResource SkeuoButton}" 
                        Click="btnNewOrder_Click"/>
                <Button Content=" Водители" Style="{StaticResource SkeuoButton}" 
                        Click="btnDrivers_Click"/>
                <Button Content="📋 История" Style="{StaticResource SkeuoButton}" 
                        Click="btnHistory_Click"/>

                <!-- Фильтр статуса -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="Статус:" VerticalAlignment="Center" FontSize="13" Margin="0,0,5,0"/>
                    <ComboBox x:Name="cmbStatus" Width="140" Style="{StaticResource SkeuoComboBox}"
                              SelectionChanged="cmbStatus_SelectionChanged">
                        <ComboBoxItem Content="Все заказы" IsSelected="True"/>
                        <ComboBoxItem Content="В ожидании"/>
                        <ComboBoxItem Content="В пути"/>
                        <ComboBoxItem Content="Завершён"/>
                        <ComboBoxItem Content="Отменён"/>
                    </ComboBox>
                </StackPanel>

                <!-- Кнопка обновления -->
                <Button Content="🔄 Обновить" Style="{StaticResource SkeuoButton}" 
                        Click="btnRefresh_Click" Margin="10,0,0,0"/>
            </WrapPanel>
        </Border>

        <!-- Таблица заказов -->
        <DataGrid Grid.Row="2" x:Name="dgOrders" AutoGenerateColumns="False" 
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeight="40"
                  FontSize="12"
                  Margin="0,0,0,10"
                  BorderBrush="#8B7355"
                  BorderThickness="1">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#FFD4AF37"/>
                    <Setter Property="Foreground" Value="#2C2C2C"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderBrush" Value="#FFB8941F"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FFFFE080"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#FFFDF5E0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFFFF0C0"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Status}" Value="Завершён">
                            <Setter Property="Background" Value="#FFE8F5E0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Отменён">
                            <Setter Property="Background" Value="#FFF5E0E0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="130"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Client.Name}" Width="150"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Client.Phone}" Width="130"/>
                <DataGridTextColumn Header="Откуда" Binding="{Binding PickupAddress}" Width="*"/>
                <DataGridTextColumn Header="Куда" Binding="{Binding DropoffAddress}" Width="*"/>
                <DataGridTextColumn Header="Водитель" Binding="{Binding Driver.FullName}" Width="150"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2} ₽}" Width="90"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Статус бар -->
        <Border Grid.Row="3" Background="#FFD4AF37" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="txtTotalOrders" Text="Всего заказов: 0" FontSize="13" Margin="0,0,20,0"/>
                    <TextBlock x:Name="txtPendingOrders" Text="В ожидании: 0" FontSize="13" Margin="0,0,20,0"/>
                    <TextBlock x:Name="txtCompletedOrders" Text="Завершено: 0" FontSize="13"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Taxi System Beta" FontSize="11" FontStyle="Italic"/>
            </Grid>
        </Border>
    </Grid>
</Window>